# Локальные файлы установки pip и результаты сканирования безопасности
/Lib/
# pip на Windows кладёт программы в Scripts\ — на Windows это та же папка, что scripts/
# с нашими скриптами. Прячем только сами программы, а не всю папку.
/Scripts/*.exe
/Scripts/*.dll
/Scripts/*.pyd
/Scripts/activate
/Scripts/activate.*
/Scripts/deactivate.*
/db.sqlite3.before-zap
/zap-report.html
/security-report.txt
# Generated Graphify knowledge graph output (keep local only)
/graphify-out/

# Отчёт визуальной проверки (scripts/visual_review.cjs)
/visual-review/

