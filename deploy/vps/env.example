# Пример deploy/vps/.env. Настоящий файл создаёт setup.sh со случайными паролями; в git он не попадает.
SITE_DOMAIN=1-2-3-4.sslip.io
DJANGO_SECRET_KEY=длинная-случайная-строка
POSTGRES_PASSWORD=длинный-случайный-пароль
WEB_CONCURRENCY=2
