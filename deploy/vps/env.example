# Пример deploy/vps/.env. Настоящий файл создаёт setup.sh со случайными паролями; в git он не попадает.
SITE_DOMAIN=1-2-3-4.sslip.io
DJANGO_SECRET_KEY=длинная-случайная-строка
POSTGRES_PASSWORD=длинный-случайный-пароль
WEB_CONCURRENCY=2
# Наблюдаемость (необязательно). Sentry — внешний сервис: перед включением обновите политику
# конфиденциальности (152-ФЗ). METRICS_TOKEN — длинная случайная строка для Prometheus.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# METRICS_TOKEN=
# Аналитика урока и эксперименты (необязательно, внешний сервис — тоже 152-ФЗ).
# POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# Озвучка A1 (необязательно): HTTPS-архив static/audio/* и его SHA256
# A1_AUDIO_ARCHIVE_URL=
# A1_AUDIO_ARCHIVE_SHA256=
