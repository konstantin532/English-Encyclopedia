# Caddy сам получает и продлевает бесплатный сертификат https (Let's Encrypt) для SITE_DOMAIN.
{$SITE_DOMAIN} {
	encode zstd gzip

	# Загруженные файлы (картинки и т. п.) отдаёт Caddy, статику — WhiteNoise внутри Django.
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		-Server
	}
}
