# Скопируйте в .env и заполните.
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Без DATABASE_URL локально используется SQLite (db.sqlite3).
# Supabase: Project Settings → Database → Connection string.
# Пулер (transaction mode, порт 6543) — для сайта:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_USES_TRANSACTION_POOLER=true
# Для миграций надёжнее прямое подключение (порт 5432) и DATABASE_USES_TRANSACTION_POOLER=false.

# Public deployment origin only (no path/query); blank locally disables canonical/sitemap.
PUBLIC_SITE_URL=

# Журнал: text (по умолчанию при DJANGO_DEBUG=true) или json (на сервере).
# DJANGO_LOG_FORMAT=text
# DJANGO_LOG_LEVEL=INFO
# Необязательно: ошибки в Sentry и счётчики /metrics/ (Bearer-токен).
# SENTRY_DSN=
# METRICS_TOKEN=
